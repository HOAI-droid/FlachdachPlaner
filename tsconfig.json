{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true, "allowImportingTsExtensions": true, "types": []
  },
  "include": ["src", "tests", "tools", "vite.config.ts"]
}
