{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimale Rechte: Hauptfenster, Speichern-Dialog und Schreiben der vom Nutzer gewählten Datei",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "core:event:default"
  ]
}
